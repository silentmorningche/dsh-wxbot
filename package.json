{
  "name": "dsh-wxbot",
  "version": "1.0.0",
  "author": "silentmorningche",
  "type": "module",
  "description": "WeChat ClawBot (iLink Bot) channel plugin for DeepSeek Harness: QR login, long-poll inbound messages, drive a DSH session, reply to WeChat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silentmorningche/dsh-wxbot.git"
  },
  "homepage": "https://github.com/silentmorningche/dsh-wxbot#readme",
  "bugs": {
    "url": "https://github.com/silentmorningche/dsh-wxbot/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
